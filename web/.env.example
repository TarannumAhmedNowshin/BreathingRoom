# Copy this file to .env.local and paste your Claude API key (platform.claude.com → API keys).
# Used only by `npm run dev` on your own machine. Never committed, never built into the live site.
VITE_ANTHROPIC_API_KEY=

# Google Gemini key for AI-written "Fix the day" requests (aistudio.google.com → Get API key).
VITE_GEMINI_API_KEY=
